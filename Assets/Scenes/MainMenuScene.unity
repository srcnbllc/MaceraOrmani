  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LevelCardManager
  infoPanel: {fileID: 2040122601}
  titleText: {fileID: 1365726955}
  descriptionText: {fileID: 0}
  allLevels:
  - levelTitle: "Ma\u011Flova Su Kemeri"
    levelDescription: "Kemerburgaz Kent Orman\u0131'n\u0131n kalbinde yer alan Ma\u011Flova
      Su Kemeri, 1554-1562 y\u0131llar\u0131 aras\u0131nda Mimar Sinan taraf\u0131ndan
      in\u015Fa edilmi\u015Ftir. 36 metre y\xFCksekli\u011Fe ve 257 metre uzunlu\u011Fa
      sahip bu \u015Faheser, d\xFCnya su mimarisinin en kusursuz \xF6rneklerinden
      biri kabul edilir. Alibey Deresi (g\xFCn\xFCm\xFCzde Alibeyk\xF6y Baraj\u0131)
      \xFCzerinde iki katl\u0131 olarak y\xFCkselen kemer, 450 y\u0131l\u0131 a\u015Fk\u0131n
      s\xFCredir \u0130stanbul'a hayat suyu ta\u015F\u0131maya devam etmektedir."
