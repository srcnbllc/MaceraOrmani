  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Kemerburgaz Kent Orman\u0131'n\u0131n kalbinde yer alan Ma\u011Flova Su
    Kemeri, 1554-1562 y\u0131llar\u0131 aras\u0131nda Mimar Sinan taraf\u0131ndan
    in\u015Fa edilmi\u015Ftir. 36 metre y\xFCksekli\u011Fe ve 257 metre uzunlu\u011Fa
    sahip bu \u015Faheser, d\xFCnya su mimarisinin en kusursuz \xF6rneklerinden biri
    kabul edilir. Alibey Deresi (g\xFCn\xFCm\xFCzde Alibeyk\xF6y Baraj\u0131) \xFCzerinde
    iki katl\u0131 olarak y\xFCkselen kemer, 450 y\u0131l\u0131 a\u015Fk\u0131n s\xFCredir
    \u0130stanbul'a hayat suyu ta\u015F\u0131maya devam etmektedir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
